// spec: 4.2
fn yes(log: List<Str>, tag: Str) -> Bool { log.push(tag); true }
fn no(log: List<Str>, tag: Str) -> Bool { log.push(tag); false }

fn main() {
    print(2 + 3 * 4)                     // * binds tighter than +
    print((2 + 3) * 4)
    print(10 - 4 - 3)                    // left associative
    print(100 / 10 / 5)
    print(-2 * 3)                        // unary before binary
    print(1 + 2 << 3)                    // + before <<
    print(1 << 2 + 1)
    print(6 & 3 + 1)                     // + before &
    print(1 | 6 & 3)                     // & before |
    print(5 ^ 1 | 2)                     // ^ before |
    print(3 & 6 ^ 1)                     // & before ^
    print(256 >> 2 >> 1)
    print(1 + 1 == 2 && 3 > 2)           // comparison before &&
    print(true || false && false)        // && before ||
    print(!true || true)
    let log: List<Str> = []
    let a = no(log, "a") && yes(log, "b")   // short-circuit
    let b = yes(log, "c") || no(log, "d")
    print("{a} {b} {log}")
    print([1, 2, 3].get(0).unwrap_or(9) + 1)  // postfix before binary
}
//> 14
//> 20
//> 3
//> 2
//> -6
//> 24
//> 8
//> 4
//> 3
//> 6
//> 3
//> 32
//> true
//> true
//> true
//> false true ["a", "c"]
//> 2
