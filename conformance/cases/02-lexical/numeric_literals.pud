// spec: 2.6
fn main() {
    print(42)
    print(1_000_000)
    print(0xFF)
    print(0b1010)
    print(0o17)
    print(3.14)
    print(1e9)
    print(2.5e-3)
    let a: I64 = 10_000_000_000
    let b: U8 = 0xff
    let f: F32 = 1.5
    let g: Float = 2
    print("{a} {b} {f} {g}")
}
//> 42
//> 1000000
//> 255
//> 10
//> 15
//> 3.14
//> 1000000000.0
//> 0.0025
//> 10000000000 255 1.5 2.0
