// spec: 3.7
fn take64(x: I64) -> I64 { x }
fn takef(x: Float) -> Float { x }
struct S { v: I64 }

fn main() {
    let a: Int = 5
    let b: I64 = a                 // annotated binding
    let i8v: I8 = -3
    let u8v: U8 = 250
    let u32v: U32 = 4000000000
    print(take64(a))               // argument
    print(takef(a))
    print(S { v: a }.v)            // field initializer
    let l: List<I64> = [a, b]      // collection element
    print(l)
    print(i8v + a)                 // I8 + I32 -> I32
    print(u8v + i8v)               // U8 + I8 -> I16
    print(u32v + a)                // U32 + I32 -> I64
    let f32v: F32 = 0.5
    print(f32v + 1.0)              // F32 + F64 -> F64
}
//> 5
//> 5.0
//> 5
//> [5, 5]
//> 2
//> 247
//> 4000000005
//> 1.5
