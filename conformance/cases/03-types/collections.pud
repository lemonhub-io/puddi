// spec: 3.9
fn total(v: ListView<Int>) -> Int {
    var t = 0
    for x in v { t += x }
    t + v[0] * 0 + v.len() * 0
}

fn items(s: Set<Int>) -> List<Int> {
    let out: List<Int> = []
    for x in s { out.push(x) }
    out
}

fn main() {
    let xs = [3, 1, 2]
    xs.push(4)
    print(xs[0])
    print(xs.get(10))
    print(xs.get(1))
    print(total(xs))                    // List converts to ListView
    let m = ["b": 2, "a": 1]
    m.insert("c", 3)
    print(m)                            // insertion order preserved
    print(m["a"])
    print(m.get("z"))
    m.remove("b")
    print(m.keys())
    let e: Map<Str, Int> = [:]
    print(e.len())
    let s = Set.from([3, 1, 3, 2, 1])
    print(items(s))                     // insertion order preserved
    print(s.contains(2))
    s.insert(9)
    s.remove(3)
    print(items(s))
    let ys = xs                         // collections are references
    ys.push(5)
    print(xs.len())
}
//> 3
//> None
//> Some(1)
//> 10
//> ["b": 2, "a": 1, "c": 3]
//> 1
//> None
//> ["a", "c"]
//> 0
//> [3, 1, 2]
//> true
//> [1, 2, 9]
//> 5
