// spec: 3.14
trait Shape {
    fn area(self) -> Float
    fn name(self) -> Str { "shape" }
}
struct Sq { s: Float }
struct Circle { r: Float }
impl Shape for Sq { fn area(self) -> Float { self.s * self.s } }
impl Shape for Circle {
    fn area(self) -> Float { 3.0 * self.r * self.r }
    fn name(self) -> Str { "circle" }
}
@derive(Show)
struct Point { x: Int, y: Int }

fn sum_iter(it: dyn Iterator<Item = Int>) -> Int {
    var t = 0
    while let Some(v) = it.next() { t += v }
    t
}

fn biggest(xs: List<dyn Shape>) -> Str {
    var best = xs[0]
    for x in xs { if x.area() > best.area() { best = x } }
    best.name()
}

fn main() {
    let items: List<dyn Show> = [Point { x: 1, y: 2 }, "hi", 42]
    for it in items { print(it.show()) }
    let shapes: List<dyn Shape> = [Sq { s: 2.0 }, Circle { r: 1.0 }]
    for s in shapes { print("{s.name()} {s.area()}") }
    print(biggest(shapes))
    print(sum_iter([1, 2, 3].iter()))
}
//> Point { x: 1, y: 2 }
//> hi
//> 42
//> shape 4.0
//> circle 3.0
//> shape
//> 6
