// std.env: process environment (wasi target).

/// Command-line arguments; the first is the program name.
pub fn args() -> List<Str> { __host(10, "").split("\0") }

/// The value of an environment variable.
pub fn get(name: Str) -> Option<Str> {
    let v = __host(11, name)
    if __host_ok() { Some(v) } else { None }
}

/// Exits the program immediately with a status code.
pub fn exit(code: Int) -> Never {
    __host(12, "{code}")
    panic("exit failed")
}
