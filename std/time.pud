// std.time: wall-clock and monotonic time.

/// Milliseconds since the Unix epoch.
pub fn now_ms() -> Float { __fmath(15, 0.0, 0.0) }

/// Milliseconds from an arbitrary fixed point; only differences are meaningful.
pub fn monotonic_ms() -> Float { __fmath(16, 0.0, 0.0) }

/// Local time zone offset from UTC in minutes.
pub fn utc_offset_minutes() -> Int { __fmath(17, 0.0, 0.0).truncate_to_int() }

/// A point in monotonic time, for measuring durations.
pub struct Instant {
    ms: Float
}

impl Instant {
    pub fn now() -> Instant { Instant { ms: monotonic_ms() } }
    pub fn elapsed_ms(self) -> Float { monotonic_ms() - self.ms }
}

/// Suspends the current task for at least `ms` milliseconds.
pub async fn sleep(ms: Int) { __host_async(100, "{ms}") }

/// Lets other tasks run before continuing.
pub async fn yield_now() { __host_async(100, "0") }
