// std.random: random numbers.

/// A random float in [0, 1).
pub fn float() -> Float { __fmath(14, 0.0, 0.0) }

/// A random integer in [lo, hi).
pub fn int(lo: Int, hi: Int) -> Int {
    if hi <= lo { panic("random.int: empty range {lo}..{hi}") }
    let span: I64 = hi - lo
    lo + (float() * span.round_to_float()).floor().truncate_to_int()
}

pub fn bool() -> Bool { float() < 0.5 }

pub fn choice<T>(xs: List<T>) -> Option<T> {
    if xs.is_empty() { None } else { Some(xs[int(0, xs.len())]) }
}

pub fn shuffle<T>(xs: List<T>) {
    var i = xs.len() - 1
    while i > 0 {
        xs.swap(i, int(0, i + 1))
        i -= 1
    }
}

/// A small deterministic generator (xorshift64*), useful for reproducible runs.
pub struct Rng {
    var state: U64
}

impl Rng {
    pub fn new(seed: U64) -> Rng { Rng { state: if seed == 0 { 0x9E3779B97F4A7C15 } else { seed } } }
    pub fn next_u64(self) -> U64 {
        var x = self.state
        x = x ^ (x >> 12)
        x = x ^ (x << 25)
        x = x ^ (x >> 27)
        self.state = x
        x.wrapping_mul(0x2545F4914F6CDD1D)
    }
    pub fn float(self) -> Float { (self.next_u64() >> 11).round_to_float() / 9007199254740992.0 }
    pub fn int(self, lo: Int, hi: Int) -> Int {
        if hi <= lo { panic("Rng.int: empty range {lo}..{hi}") }
        let span: U64 = (hi - lo).wrap_to_u64()
        lo + (self.next_u64() % span).wrap_to_int()
    }
}
