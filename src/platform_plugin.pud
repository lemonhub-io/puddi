// ---------------------------------------------------------------- plugin platform
// Components for host-defined worlds get only what their world imports:
// `print` and `std.log` go to `wasi:logging` when the world has it, and the
// clock, random, HTTP and worker pieces are linked in for the interfaces the
// world provides.

pub fn __plat_write(fd: Int, s: Str) {
    var t = s
    if t.ends_with("\n") { t = __str_slice(t, 0, __str_len(t) - 1) }
    if t != "" { __plat_log(if fd == 2 { "error" } else { "info" }, t) }
}

pub fn __plat_panic(msg: Str) { __plat_log("critical", "panic: {msg}") }

pub fn __plat_host(op: Int, arg: Str) -> Str {
    __plat().ok = true
    let parts = arg.split("\0")
    match op {
        22 -> {
            __plat_write(1, arg)
            ""
        }
        23 -> {
            __plat_write(2, arg)
            ""
        }
        30 -> {
            __plat_log(parts[0], parts.slice(1, parts.len()).join("\0"))
            ""
        }
        40 -> __plat_tasks(op, arg)
        41 -> __plat_tasks(op, arg)
        42 -> __plat_tasks(op, arg)
        43 -> __plat_tasks(op, arg)
        50 -> __plat_worker(op, arg)
        51 -> __plat_worker(op, arg)
        52 -> __plat_worker(op, arg)
        53 -> __plat_worker(op, arg)
        54 -> __plat_worker(op, arg)
        _ -> {
            __plat().ok = false
            "operation {op} is not available in this plugin"
        }
    }
}
