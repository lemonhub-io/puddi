import std.time

async fn step(name: Str, ms: Int, log: List<Str>) -> Int {
    time.sleep(ms).await
    log.push(name)
    ms
}

async fn forever(log: List<Str>) -> Int {
    loop {
        time.sleep(5).await
        if log.len() > 100 { return 0 }
    }
}

async fn failing() -> Result<Int, Str> {
    time.sleep(10).await
    Err("boom")
}

async fn main() {
    let log: List<Str> = []
    let total = task.scope(async |s| {
        let a = s.spawn(step("slow", 40, log))
        let b = s.spawn(step("fast", 10, log))
        let c = s.spawn(step("mid", 25, log))
        a.await + b.await + c.await
    }).await
    print("{total} {log}")

    let t0 = time.monotonic_ms()
    let r: Result<Int, Str> = task.scope(async |s| {
        let _bg = s.spawn(forever(log))
        let f = s.spawn(failing())
        let v = f.await?
        Ok(v)
    }).await
    let took = time.monotonic_ms() - t0
    print("{r} cancelled quickly: {took < 500.0}")

    let unawaited = task.scope(async |s| {
        s.spawn(step("background", 5, log))
        "body done"
    }).await
    print("{unawaited} {log.last()}")
}
