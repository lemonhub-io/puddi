import std.worker

@derive(Transfer, Show)
struct Job {
    id: Int
    data: List<Int>
    tag: Option<Str>
}

@derive(Transfer, Show, Eq)
enum Reply {
    Sum(Int, Int)
    Done
}

async fn summer(port: worker.Port<Job, Reply>) {
    while let Some(job) = port.recv().await {
        port.send(Reply.Sum(job.id, job.data.sum()))
    }
    port.send(Reply.Done)
}

async fn main() {
    task.scope(async |s| {
        let w = s.worker(summer)
        w.send(Job { id: 1, data: [1, 2, 3], tag: None })
        w.send(Job { id: 2, data: [10, 20], tag: Some("x\0y \{\}") })
        print(w.recv().await)
        print(w.recv().await)
    }).await
    print("scope ended")
}
