struct Point {
    x: Int
    var y: Int
}

enum Shape {
    Circle(Float)
    Rect { w: Float, h: Float }
    Empty
}

fn area(s: Shape) -> Float {
    match s {
        Shape.Circle(r) -> 3.0 * r * r
        Shape.Rect { w, h } -> w * h
        Shape.Empty -> 0.0
    }
}

fn fib(n: Int) -> Int {
    if n < 2 { n } else { fib(n - 1) + fib(n - 2) }
}

fn main() {
    print("hello, puddi")
    let p = Point { x: 1, y: 2 }
    p.y = 5
    print("p = ({p.x}, {p.y})")
    print(fib(20))
    print(area(Shape.Circle(2.0)))
    print(area(Shape.Rect { w: 2.0, h: 3.5 }))
    let xs = [1, 2, 3, 4, 5]
    let ys = xs.map(|x| x * x).filter(|x| x % 2 == 1)
    print(ys)
    var total = 0
    for i in 0..10 {
        total += i
    }
    print("total {total}")
    for i in 1..=3 { print(i) }
    let m = ["a": 1, "b": 2]
    m["c"] = 3
    print(m)
    print(m.get("b"))
    print(m.get("z"))
    let label = match 404 {
        200 -> "ok"
        404 -> "not found"
        500..=599 -> "server error"
        _ -> "other"
    }
    print(label)
    var count = 0
    let inc = || count += 1
    inc()
    inc()
    print("count {count}")
    let words = "the quick brown fox".split(" ")
    print(words.join("-"))
    print((1, "two", 3.5))
    let big: I64 = 5_000_000_000
    print(big * 2)
    print(7 / 2)
    print(-7 % 3)
    print(1.5 + 2)
    print('x')
    let ab = ["a", "b"]
    print("{ab}")
}
