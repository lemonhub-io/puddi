import std.time

fn main() {
    let t = time.monotonic_ms()
    let n = 1_000_000
    let xs: List<Int> = List.with_capacity(n)
    var s: I64 = 7
    var i = 0
    while i < n {
        s = (s * 1103515245 + 12345) % 2147483648
        xs.push(s.to_int().unwrap())
        i += 1
    }
    xs.sort()
    var ok = true
    var k = 1
    while k < n {
        if xs[k - 1] > xs[k] { ok = false }
        k += 1
    }
    print("sort {ok}/{xs[0]}/{xs[n / 2]}/{xs[n - 1]} {time.monotonic_ms() - t}")
}
